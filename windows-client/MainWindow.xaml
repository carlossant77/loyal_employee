<Window x:Class="ExoAgente.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Agente CI/SonarQube" Height="700" Width="1100" Loaded="Window_Loaded"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="Atualizar" Click="Refresh_Click" Margin="0,0,8,0"/><TextBlock Text="Backend:" VerticalAlignment="Center"/><TextBox x:Name="BackendUrl" Text="http://localhost:8000" Width="240" Margin="8,0,0,0"/></StackPanel><TabControl Grid.Row="1" Margin="0,16,0,0"><TabItem Header="Histórico de Jobs"><DataGrid x:Name="JobsGrid" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem><TabItem Header="Pendências"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ComboBox x:Name="StatusFilter" Width="240" SelectionChanged="StatusFilter_Changed"><ComboBoxItem Content="Todos" IsSelected="True"/><ComboBoxItem Content="não_corrigida"/><ComboBoxItem Content="skipped"/><ComboBoxItem Content="aguardando_merge"/><ComboBoxItem Content="corrigida"/></ComboBox><DataGrid Grid.Row="1" x:Name="FindingsGrid" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,8,0,0"/></Grid></TabItem><TabItem Header="Configuração do Escopo"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="ScopeJson" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><Button Grid.Row="1" Content="Salvar escopo JSON" Click="SaveScope_Click" Height="32" Margin="0,8,0,0"/></Grid></TabItem><TabItem Header="Aguardando merge"><DataGrid x:Name="PrGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Pendência" Binding="{Binding [id]}"/><DataGridTextColumn Header="Job" Binding="{Binding [job_id]}"/><DataGridTextColumn Header="Correlação" Binding="{Binding [correlation]}"/><DataGridTemplateColumn Header="PR"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><Hyperlink NavigateUri="{Binding [pr_url]}" RequestNavigate="PrLink_RequestNavigate">Abrir PR</Hyperlink></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></TabItem></TabControl></Grid></Window>
